{
	"$schema": "https://json.schemastore.org/package",
	"name": "volter",
	"version": "0.0.173",
	"description": "Secure, lightweight, and user-friendly modern JavaScript toolchain optimized for performance and minimalism.",
	"main": "index.ts",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"build": "bun build ./src/*.ts --outdir ./dist"
	},
	"exports": {
		"./*": {
			"types": "./types/*.d.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		}
	},
	"files": ["dist", "types"],
	"types": "./src/types.d.ts",
	"typings": "./src/types.d.ts",
	"devDependencies": {
		"typescript": "latest",
		"@types/bun": "latest"
	},
	"peerDependencies": {},
	"dependencies": {
		"@paralleldrive/cuid2": "latest",
		"@upstash/redis": "latest",
		"ansi-colors": "latest",
		"drizzle-orm": "latest",
		"resend": "^6.4.2",
		"zod": "latest"
	}
}
