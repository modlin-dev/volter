{
	"$schema": "https://json.schemastore.org/package",
	"name": "volter",
	"version": "0.0.173",
	"description": "⚡Secure, lightweight, and user-friendly modern JavaScript toolchain optimized for performance and minimalism.",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "bun build ./src/*.ts --outdir ./dist"
	},
	"exports": {
        ".": "./src/index.ts",
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"files": [
		"dist",
		"types"
	],
	"types": "./src/types.d.ts",
	"typings": "./src/types.d.ts",
	"devDependencies": {
		"@types/bun": "^1.3.3",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.0.4",
		"ansi-colors": "^4.1.3",
		"drizzle-orm": "^0.45.1",
		"resend": "^6.4.2",
		"zod": "^4.1.13"
	}
}
