{
	"$schema": "https://json.schemastore.org/package",
	"name": "volter",
	"version": "0.0.172",
	"description": "Secure, lightweight, and user-friendly modern JavaScript toolchain optimized for performance and minimalism.",
	"main": "index.ts",
	"module": "index.ts",
	"type": "module",
	"scripts": {
		"build": "bun build ./src/*.ts --outdir ./dist --target node"
	},
	"exports": {
		"./*": {
            "types": "./src/*.d.ts",
			"import": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
    "types": "./src/types.d.ts",
    "typings": "./src/types.d.ts",
	"devDependencies": {
		"typescript": "latest",
		"@types/bun": "latest"
	},
	"peerDependencies": {},
	"dependencies": {
		"@paralleldrive/cuid2": "latest",
		"ansi-colors": "^4.1.3",
		"drizzle-orm": "latest",
		"zod": "latest"
	}
}
