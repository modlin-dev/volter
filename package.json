{
	"$schema": "https://json.schemastore.org/package",
	"name": "volter",
	"version": "0.0.181",
	"description": "Secure, lightweight, and user-friendly modern JavaScript toolchain optimized for performance and minimalism.",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"type": "module",
	"scripts": {
		"lint": "biome lint ./src --apply",
		"format": "biome format ./src --write",
		"test": "bun test",
		"build": "bun build ./src/**.ts --outdir ./dist --minify && tsc --declarationMap false"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./types/index.d.ts",
		"exports": {
			".": {
				"types": "./types/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./*": {
				"types": "./types/*.d.ts",
				"import": "./dist/*.js",
				"default": "./dist/*.js"
			}
		},
		"files": [
			"dist",
			"types"
		]
	},
	"types": "./src/index.ts",
	"typings": "./src/index.ts",
	"devDependencies": {
		"@types/bun": "^1.3.3",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.0.4",
		"ansi-colors": "^4.1.3",
		"drizzle-orm": "^0.45.1",
		"resend": "^6.4.2",
		"zod": "^4.1.13"
	}
}
